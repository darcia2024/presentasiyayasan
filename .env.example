# ==========================================================================
# PERISA AZHARIYAH — Contoh Konfigurasi Lingkungan
#
# Salin berkas ini menjadi `.env`, lalu isi nilainya.
#
#   cp .env.example .env
#
# `.env` TIDAK PERNAH masuk repo (sudah diabaikan di .gitignore). Jangan
# menulis kunci atau kata sandi sungguhan di berkas contoh ini.
#
# --------------------------------------------------------------------------
# TIGA LINGKUNGAN YANG BERBEDA (audit 10 September 2026, D20)
#
# Berkas ini SEBELUMNYA hanya menggambarkan .env lokal, sehingga variabel
# yang sebenarnya harus diisi di tempat lain (Vercel, Supabase Edge Function
# secrets, GitHub Actions) tidak pernah tercatat di mana pun. Kolom "Di mana"
# di bawah menyatakannya, karena mengisi nilai yang benar di tempat yang
# salah adalah bentuk kegagalan yang paling sulit dilacak di proyek ini.
#
#   LOKAL     berkas .env ini (server pengembangan, `npm run build`, uji)
#   VERCEL    Settings -> Environment Variables (dibaca saat build)
#   EDGE      Supabase -> Edge Functions -> Secrets
#             (`npx supabase secrets set NAMA=nilai`)
#   ACTIONS   GitHub -> Settings -> Secrets and variables -> Actions
#
# Kolom "Wajib" berarti: tanpa itu, ada fungsi yang BERHENTI BEKERJA —
# bukan berjalan setengah-setengah.
# ==========================================================================


# ==========================================================================
# LINGKUNGAN — gerbang keamanan, bukan sekadar label
# ==========================================================================

# APP_ENV        Wajib: YA        Di mana: LOKAL, VERCEL, EDGE
# production | staging | development | test
#
# Fitur bantu pengembangan yang mengeluarkan rahasia HANYA hidup kalau
# nilainya development atau test. Nilai yang HILANG atau salah ketik
# dianggap 'production' (gagal tertutup). staging diperlakukan setara
# production: isinya biasanya cukup nyata untuk berbahaya kalau bocor.
#
# 12 Sep 2026: sejak login memakai PIN (bukan OTP), tidak ada lagi kode
# rahasia yang bisa bocor lewat respons login. Yang masih dijaga variabel
# ini di sisi peramban: alat peraga presentasi (bilah "SIMULASI SISTEM"
# dan pemilih persona) hanya muncul di build development/test.
APP_ENV=development

# NODE_ENV       Wajib: tidak     Di mana: LOKAL
# Dipakai server.js dan sebagai cadangan APP_ENV kalau APP_ENV kosong.
NODE_ENV=development

# PORT           Wajib: tidak     Di mana: LOKAL
# Port server pengembangan (`npm start`).
PORT=3020

# PUBLIC_BASE_URL  Wajib: YA di produksi   Di mana: LOKAL, VERCEL
# Alamat publik aplikasi. Dipakai membangun tautan absolut — terutama QR
# verifikasi di lembar sertifikat. Salah isi = QR menunjuk ke alamat lama.
PUBLIC_BASE_URL=http://localhost:3020


# ==========================================================================
# SUPABASE — basis data, autentikasi, penyimpanan
# ==========================================================================

# SUPABASE_URL       Wajib: YA    Di mana: LOKAL, VERCEL, EDGE*, ACTIONS
# SUPABASE_ANON_KEY  Wajib: YA    Di mana: LOKAL, VERCEL
#
# * EDGE mengisinya sendiri secara otomatis — tidak perlu diset manual.
#
# Kunci `anon` aman dibaca browser karena dibatasi Row Level Security,
# bukan kerahasiaan. Kalau kedua nilai ini kosong, build TETAP BERHASIL tapi
# aplikasi diam-diam turun ke mode peraga tanpa login sungguhan — jadi
# kalau login tiba-tiba mati di produksi, dua nilai ini yang pertama
# diperiksa.
#
# CATATAN: SUPABASE_URL juga harus cocok dengan origin di dalam
# Content-Security-Policy pada vercel.json. `npm run build` menolak berjalan
# kalau keduanya melenceng (tools/periksa-csp.js).
SUPABASE_URL=
SUPABASE_ANON_KEY=

# SUPABASE_SERVICE_ROLE_KEY  Wajib: YA    Di mana: LOKAL(uji), EDGE*, ACTIONS
# MELEWATI SELURUH aturan akses tingkat baris. Hanya boleh ada di sisi
# server. Tidak pernah dikirim ke browser santri — tools/gen-config.js
# tidak pernah menyentuhnya.
SUPABASE_SERVICE_ROLE_KEY=

# SUPABASE_DB_URL    Wajib: YA untuk migrasi & cadangan   Di mana: LOKAL, ACTIONS
# Connection string Postgres. Pakai **Session pooler (port 5432)**, bukan
# Transaction pooler (6543) — pg_dump tidak bisa lewat mode transaksi.
SUPABASE_DB_URL=

# SUPABASE_ACCESS_TOKEN  Wajib: tidak    Di mana: LOKAL
# Token akun untuk `supabase link`. Tidak diperlukan kalau perintah CLI
# dijalankan dengan --db-url.
SUPABASE_ACCESS_TOKEN=

# APP_JWT_SECRET     Wajib: YA    Di mana: LOKAL(uji), EDGE
# Rahasia penandatangan sesi PERISA — yaitu JWT Secret proyek Supabase
# (Settings -> API -> JWT Secret). Edge Function auth-login-pin memakainya
# untuk menerbitkan sesi sendiri (lihat docs/fase-1-arsitektur.md bagian 3),
# bukan lewat supabase.auth.signIn*, karena login memakai nomor WhatsApp +
# PIN yang ditetapkan pengurus, bukan email/password bawaan Supabase.
# BOCOR = siapa pun bisa memalsukan sesi siapa pun.
APP_JWT_SECRET=

# ALLOWED_ORIGINS    Wajib: YA di produksi    Di mana: EDGE
# Daftar origin yang boleh memanggil Edge Function dari peramban, dipisah
# koma, tanpa garis miring penutup:
#   ALLOWED_ORIGINS=https://presentasiyayasan.vercel.app,https://perisa.contoh.id
#
# Kosong di production/staging = DIANGGAP SALAH KONFIGURASI: seluruh
# panggilan dari peramban dijawab 503 dengan pesan yang menyebut variabel
# ini. Sengaja begitu — sebelum audit S6, nilainya efektif "*" alias siapa
# pun boleh, termasuk halaman phishing yang meniru PERISA.
# Di development/test boleh dikosongkan (origin apa pun diterima).
ALLOWED_ORIGINS=


# ==========================================================================
# WHATSAPP — ringkasan mingguan saja
# ==========================================================================

# WA_GATEWAY_URL     Wajib: tidak             Di mana: EDGE
# WA_GATEWAY_TOKEN   Wajib: tidak             Di mana: EDGE
# WA_SENDER_NUMBER   Wajib: tidak (informasi) Di mana: EDGE
#
# ############ LOGIN TIDAK LAGI BUTUH INI (12 September 2026) ############
# DULU: gateway ini adalah jalur pengiriman kode OTP — satu-satunya cara
#       masuk ke aplikasi. Kosong berarti login mati total di produksi.
#       Kenyataannya gateway itu tidak pernah disiapkan, dan yang menutupi
#       ketiadaannya adalah "mode pengembangan" yang mengembalikan kode OTP
#       di badan respons HTTP. Karena APP_ENV di Edge Function produksi
#       ternyata berisi 'development', mode itu AKTIF di produksi: siapa
#       pun yang tahu satu nomor terdaftar bisa masuk sebagai pemiliknya.
# SEKARANG: login memakai nomor WhatsApp + PIN yang ditetapkan pengurus
#       (auth-login-pin). Tidak ada kode yang dikirim ke mana pun, jadi
#       gateway ini TIDAK lagi menghalangi siapa pun untuk masuk.
#
# Yang MASIH memakainya: ringkasan mingguan ke wali
# (kirim-ringkasan-mingguan). Kosong = ringkasan tidak terkirim; aplikasinya
# sendiri tetap berjalan normal.
# ######################################################################
WA_GATEWAY_URL=
WA_GATEWAY_TOKEN=
WA_SENDER_NUMBER=

# CRON_SECRET        Wajib: YA    Di mana: EDGE, ACTIONS
# Header X-Cron-Secret yang harus dikirim penjadwal supaya Edge Function
# kirim-ringkasan-mingguan mau berjalan — tanpa ini siapa saja yang tahu
# URL-nya bisa memicu pengiriman WhatsApp ke semua wali (dan menghabiskan
# kuota gateway yayasan). Nilai di EDGE dan ACTIONS harus SAMA PERSIS.
# Bangkitkan dengan:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=


# ==========================================================================
# VIDEO — Fase 3
# ==========================================================================

# Semua opsional; video saat ini disajikan dari Supabase Storage lewat URL
# bertanda tangan (Edge Function video-signed-url), bukan dari penyedia luar.
VIDEO_LIBRARY_ID=
VIDEO_API_KEY=
VIDEO_TOKEN_SECRET=
# Umur tautan video dalam detik. Sengaja pendek: tautan yang disalin dan
# dikirim ke orang lain harus sudah mati sebelum sempat dibuka.
VIDEO_URL_TTL_SECONDS=300


# ==========================================================================
# KUIS — Fase 4, dirombak audit K2
# ==========================================================================

# Semua opsional. Pagar anti-penyalahgunaan, bukan aturan pedagogis:
# anak yang benar-benar belajar tidak pernah mendekati angka-angka ini.
KUIS_SOAL_TTL_DETIK=300         # baku 300 — umur satu soal sebelum kedaluwarsa
KUIS_MAKS_SOAL_PER_MENIT=30     # baku 30  — penerbitan soal per santri per menit
KUIS_JUMLAH_PILIHAN=4           # baku 4   — jumlah pilihan ganda per soal
XP_PER_JAWABAN_BENAR=10         # baku 10  — XP per mufrodat baru yang dikuasai


# ==========================================================================
# PEMANTAUAN — Fase 7
# ==========================================================================

# SENTRY_DSN         Wajib: tidak     Di mana: (belum dipakai kode mana pun)
# Disiapkan untuk pemantauan error per-kejadian. Pemantauan ketersediaan
# dasar sudah berjalan lewat .github/workflows/uptime-check.yml.
SENTRY_DSN=


# ==========================================================================
# HANYA DI GITHUB ACTIONS — tidak perlu ada di .env
# ==========================================================================
#
# SECRET:
#   SUPABASE_DB_URL, SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY  (cadangan)
#   CRON_SECRET                                               (ringkasan mingguan)
#   BACKUP_ENCRYPTION_PASSPHRASE                              (cadangan terenkripsi)
#     Tanpa ini, cadangan TIDAK dikirim ke tujuan di luar Supabase.
#     SIMPAN JUGA DI LUAR GITHUB — tanpa frasa ini cadangannya tidak bisa
#     dibuka lagi selamanya.
#   BACKUP_S3_ACCESS_KEY_ID / BACKUP_S3_SECRET_ACCESS_KEY     (opsional)
#
# VARIABLE (bukan secret — nilainya publik):
#   SITE_URL                 alamat situs produksi (pemantauan ketersediaan)
#   SUPABASE_URL_PUBLIC      sama dengan SUPABASE_URL (pemantauan & CI)
#   SUPABASE_ANON_KEY_PUBLIC sama dengan SUPABASE_ANON_KEY (CI build dist)
#   BACKUP_DESTINATIONS      baku "supabase,artifact"; boleh + ",s3"
#   BACKUP_ARTIFACT_RETENTION_DAYS, BACKUP_SUPABASE_RETENTION_DAYS
#   RETENSI_AUDIT_HARI, RETENSI_KUIS_HARI
#     Masa simpan data. SELAMA BELUM DIISI, TIDAK ADA yang dihapus.
#     Jalankan workflow "Retensi Data PERISA" mode `laporan` lebih dulu
#     untuk melihat umur data nyata sebelum menetapkan angkanya.
