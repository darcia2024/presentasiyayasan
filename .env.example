# ==========================================================================
# PERISA AZHARIYAH — Contoh Konfigurasi Lingkungan
#
# Salin berkas ini menjadi `.env`, lalu isi nilainya.
#
#   cp .env.example .env
#
# `.env` TIDAK PERNAH masuk repo (sudah diabaikan di .gitignore). Jangan
# menulis kunci atau kata sandi sungguhan di berkas contoh ini.
# ==========================================================================

# --------------------------------------------------------------- Server lokal
# Port server pengembangan.
PORT=3020

# Lingkungan yang sedang berjalan: development | staging | production
NODE_ENV=development

# Alamat publik aplikasi. Dipakai untuk membangun tautan absolut, misalnya
# QR verifikasi sertifikat nanti di Fase 6.
PUBLIC_BASE_URL=http://localhost:3020


# ==========================================================================
# BELUM DIPAKAI — disiapkan untuk fase berikutnya.
# Biarkan kosong sampai fasenya benar-benar dikerjakan.
# ==========================================================================

# ------------------------------------------------- Fase 1: Basis data & login
# Supabase. Kunci `anon` aman dibaca browser karena dibatasi aturan akses
# tingkat baris. Kunci `service_role` MELEWATI seluruh aturan itu — hanya
# boleh ada di sisi server, tidak pernah dikirim ke browser santri.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Rahasia penandatangan JWT proyek Supabase (Settings -> API -> JWT Secret).
# Edge Function auth-otp-verify memakai ini untuk menerbitkan sesi login
# sendiri (lihat docs/fase-1-arsitektur.md, bagian 3) — bukan lewat
# supabase.auth.signIn*, karena OTP dikirim lewat WhatsApp, bukan SMS.
# HANYA di sisi server. Bocor -> siapa pun bisa memalsukan sesi siapa pun.
SUPABASE_JWT_SECRET=

# Gateway WhatsApp untuk OTP dan ringkasan mingguan wali murid.
# Ingat: di jenjang SD, OTP dikirim ke nomor WALI, bukan santri.
# Dikosongkan = mode pengembangan: kode OTP dicetak ke log server, tidak
# dikirim sungguhan. Lihat supabase/functions/_shared/wa-gateway.ts.
WA_GATEWAY_URL=
WA_GATEWAY_TOKEN=
WA_SENDER_NUMBER=

# ------------------------------------------------------- Fase 3: Video & media
# Hosting video dengan URL bertanda tangan berumur pendek.
VIDEO_LIBRARY_ID=
VIDEO_API_KEY=
VIDEO_TOKEN_SECRET=
# Umur tautan video dalam detik. Sengaja pendek: tautan yang disalin dan
# dikirim ke orang lain harus sudah mati sebelum sempat dibuka.
VIDEO_URL_TTL_SECONDS=300

# --------------------------------------------------- Fase 5: Asisten Bahasa Arab
# Kunci ini HANYA boleh dipakai di sisi server. Jangan pernah menaruhnya di
# berkas apa pun di dalam js/ — seluruh isi folder itu terkirim ke browser.
ANTHROPIC_API_KEY=
# Batas pemakaian per santri per hari, penjaga agar tagihan tidak mengejutkan.
AI_DAILY_LIMIT_PER_SANTRI=20

# ------------------------------------------------------- Fase 7: Pemantauan
SENTRY_DSN=
