# ==========================================================================
# PERISA AZHARIYAH — Header HTTP untuk Cloudflare Pages
#
# Cloudflare Pages membaca berkas ini apa adanya. Aturan paling spesifik
# ditulis lebih dulu.
# ==========================================================================

# --------------------------------------------------------- Service worker
# Wajib: tanpa Service-Worker-Allowed, service worker tidak boleh mengendalikan
# seluruh situs. Dan JANGAN pernah di-cache — berkas inilah yang memberi tahu
# perangkat bahwa ada versi baru.
/sw.js
  Service-Worker-Allowed: /
  Cache-Control: no-cache, no-store, must-revalidate

# ------------------------------------------------------------- Manifest
/manifest.webmanifest
  Content-Type: application/manifest+json; charset=utf-8
  Cache-Control: public, max-age=3600

# ------------------------------------------------------- Font & ikon lokal
# Isinya tidak pernah berubah, jadi boleh disimpan setahun penuh.
/vendor/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

/vendor/phosphor/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

# ------------------------------------------------------ Ikon & gambar aplikasi
/icons/*
  Cache-Control: public, max-age=2592000

# ------------------------------------------------------------------ HTML
# Halaman selalu diperiksa ulang; berkas CSS/JS di dalamnya sudah ber-versi
# sendiri lewat parameter ?v=, jadi pembaruan tetap sampai ke pengguna.
/*.html
  Cache-Control: no-cache

# ----------------------------------------------------------- Seluruh situs
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), payment=()
  # Mikrofon dibiarkan aktif: dipakai simulasi percakapan suara santri.
